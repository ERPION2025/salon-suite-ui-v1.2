[
 {
  "doctype": "Custom Field",
  "name": "Customer-custom_salon_preferences_section",
  "dt": "Customer",
  "fieldname": "custom_salon_preferences_section",
  "label": "Salon Preferences",
  "fieldtype": "Section Break",
  "insert_after": "more_info",
  "collapsible": 1
 },
 {
  "doctype": "Custom Field",
  "name": "Customer-custom_preferred_stylist",
  "dt": "Customer",
  "fieldname": "custom_preferred_stylist",
  "label": "Preferred Stylist",
  "fieldtype": "Link",
  "options": "Salon Stylist",
  "insert_after": "custom_salon_preferences_section"
 },
 {
  "doctype": "Custom Field",
  "name": "Customer-custom_color_formula",
  "dt": "Customer",
  "fieldname": "custom_color_formula",
  "label": "Color Formula",
  "fieldtype": "Data",
  "insert_after": "custom_preferred_stylist"
 },
 {
  "doctype": "Custom Field",
  "name": "Customer-custom_salon_cb_1",
  "dt": "Customer",
  "fieldname": "custom_salon_cb_1",
  "fieldtype": "Column Break",
  "insert_after": "custom_color_formula"
 },
 {
  "doctype": "Custom Field",
  "name": "Customer-custom_allergies",
  "dt": "Customer",
  "fieldname": "custom_allergies",
  "label": "Allergies",
  "fieldtype": "Small Text",
  "insert_after": "custom_salon_cb_1"
 },
 {
  "doctype": "Custom Field",
  "name": "Customer-custom_birthday",
  "dt": "Customer",
  "fieldname": "custom_birthday",
  "label": "Birthday",
  "fieldtype": "Date",
  "insert_after": "custom_allergies"
 },
 {
  "doctype": "Custom Field",
  "name": "Item-custom_package_sessions",
  "dt": "Item",
  "fieldname": "custom_package_sessions",
  "label": "Package Sessions",
  "fieldtype": "Int",
  "insert_after": "item_group",
  "depends_on": "eval:doc.item_group=='Packages'",
  "description": "Sessions included when this package is sold (Salon Suite)"
 },
 {
  "doctype": "Custom Field",
  "name": "Item-custom_package_validity_days",
  "dt": "Item",
  "fieldname": "custom_package_validity_days",
  "label": "Package Validity (Days)",
  "fieldtype": "Int",
  "insert_after": "custom_package_sessions",
  "depends_on": "eval:doc.item_group=='Packages'",
  "description": "Days from activation until the package expires; blank = no expiry"
 },
 {
  "doctype": "Custom Field",
  "name": "Purchase Invoice-custom_salon_purchase_category",
  "dt": "Purchase Invoice",
  "fieldname": "custom_salon_purchase_category",
  "label": "Salon Purchase Category",
  "fieldtype": "Select",
  "options": "\nConsumables\nRetail Products\nOverheads & Bills\nEquipment\nAssets",
  "insert_after": "supplier",
  "in_standard_filter": 1
 },
 {
  "doctype": "Custom Field",
  "name": "Attendance-custom_salon_branch",
  "dt": "Attendance",
  "fieldname": "custom_salon_branch",
  "label": "Salon Branch",
  "fieldtype": "Link",
  "options": "Cost Center",
  "insert_after": "company",
  "allow_on_submit": 1,
  "in_standard_filter": 1
 },
 {
  "doctype": "Custom Field",
  "name": "Employee Checkin-custom_salon_branch",
  "dt": "Employee Checkin",
  "fieldname": "custom_salon_branch",
  "label": "Salon Branch",
  "fieldtype": "Link",
  "options": "Cost Center",
  "insert_after": "device_id",
  "in_standard_filter": 1
 },
 {
  "doctype": "Custom Field",
  "name": "Item-custom_bookable_online",
  "dt": "Item",
  "fieldname": "custom_bookable_online",
  "label": "Bookable Online",
  "fieldtype": "Check",
  "insert_after": "custom_package_validity_days",
  "description": "Show this service on the public online booking page (/book)"
 },
 {
  "doctype": "Custom Field",
  "name": "Item-custom_service_minutes",
  "dt": "Item",
  "fieldname": "custom_service_minutes",
  "label": "Service Duration (Minutes)",
  "fieldtype": "Int",
  "insert_after": "custom_bookable_online",
  "description": "Used for online booking slots; blank = 30"
 }
]
